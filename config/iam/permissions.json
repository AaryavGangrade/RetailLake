{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "InspectBucketProtection",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLocation",
        "s3:GetBucketPublicAccessBlock"
      ],
      "Resource": "arn:aws:s3:::retaillake-dev-037315459859-mumbai"
    },
    {
      "Sid": "ListOnlyPipelinePrefixes",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::retaillake-dev-037315459859-mumbai",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "bronze/olist/",
            "bronze/olist/*",
            "silver/runs/*",
            "gold/runs/*"
          ]
        }
      }
    },
    {
      "Sid": "ReadBronzeAndPublishedSnapshots",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": [
        "arn:aws:s3:::retaillake-dev-037315459859-mumbai/bronze/olist/*",
        "arn:aws:s3:::retaillake-dev-037315459859-mumbai/silver/runs/*",
        "arn:aws:s3:::retaillake-dev-037315459859-mumbai/gold/runs/*"
      ]
    },
    {
      "Sid": "WriteEncryptedOutputSnapshots",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": [
        "arn:aws:s3:::retaillake-dev-037315459859-mumbai/silver/runs/*",
        "arn:aws:s3:::retaillake-dev-037315459859-mumbai/gold/runs/*"
      ],
      "Condition": {
        "StringEquals": {
          "s3:x-amz-server-side-encryption": "AES256"
        }
      }
    }
  ]
}