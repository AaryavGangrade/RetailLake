{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadBronzeObjects",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::retaillake-dev-037315459859-mumbai/bronze/olist/*"
    },
    {
      "Sid": "ListBronzePrefix",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::retaillake-dev-037315459859-mumbai",
      "Condition": {
        "StringLike": {"s3:prefix": ["bronze/olist", "bronze/olist/", "bronze/olist/*"]}
      }
    },
    {
      "Sid": "LocateBucket",
      "Effect": "Allow",
      "Action": "s3:GetBucketLocation",
      "Resource": "arn:aws:s3:::retaillake-dev-037315459859-mumbai"
    },
    {
      "Sid": "SelfAssumeForUnityCatalog",
      "Effect": "Allow",
      "Action": "sts:AssumeRole",
      "Resource": "arn:aws:iam::037315459859:role/RetailLakeDatabricksBronzeReadRole"
    }
  ]
}
