{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyAnyoneOutsideMyOrgAndAWS",
      "Effect": "Deny",
      "Principal": "*",
      "Action": [
        "aoss:*",
        "appconfig:*",
        "appstream:*",
        "autoscaling:*",
        "codebuild:*",
        "codecommit:*",
        "cognito-identity:*",
        "cognito-idp:*",
        "comprehend:*",
        "comprehendmedical:*",
        "dax:*",
        "dynamodb:*",
        "ecr:*",
        "health:*",
        "kinesisvideo:*",
        "kms:*",
        "logs:*",
        "s3:*",
        "secretsmanager:*",
        "sqs:*",
        "sts:*",
        "support:*",
        "textract:*",
        "transcribe:*",
        "translate:*"
      ],
      "Condition": {
        "StringNotEqualsIfExists": {
          "aws:PrincipalOrgID": "${aws:ResourceOrgID}"
        },
        "Null": {
          "aws:PrincipalARN": "false"
        },
        "BoolIfExists": {
          "aws:PrincipalIsAWSService": "false"
        }
      },
      "NotResource": "arn:aws:iam::037315459859:role/RetailLakeDatabricksBronzeReadRole"
    },
    {
      "Sid": "DenyRetailLakeRoleExceptTrustedDatabricks",
      "Effect": "Deny",
      "Principal": "*",
      "Action": [
        "aoss:*",
        "appconfig:*",
        "appstream:*",
        "autoscaling:*",
        "codebuild:*",
        "codecommit:*",
        "cognito-identity:*",
        "cognito-idp:*",
        "comprehend:*",
        "comprehendmedical:*",
        "dax:*",
        "dynamodb:*",
        "ecr:*",
        "health:*",
        "kinesisvideo:*",
        "kms:*",
        "logs:*",
        "s3:*",
        "secretsmanager:*",
        "sqs:*",
        "sts:*",
        "support:*",
        "textract:*",
        "transcribe:*",
        "translate:*"
      ],
      "Resource": "arn:aws:iam::037315459859:role/RetailLakeDatabricksBronzeReadRole",
      "Condition": {
        "StringNotEqualsIfExists": {
          "aws:PrincipalOrgID": "${aws:ResourceOrgID}"
        },
        "Null": {
          "aws:PrincipalARN": "false"
        },
        "BoolIfExists": {
          "aws:PrincipalIsAWSService": "false"
        },
        "ArnNotEquals": {
          "aws:PrincipalArn": "arn:aws:iam::414351767826:role/unity-catalog-prod-UCMasterRole-14S5ZJVKOTYTL"
        }
      }
    },
    {
      "Sid": "DenyAWSWhenItsNotMyOrgsSourceAccount",
      "Effect": "Deny",
      "Principal": "*",
      "Action": [
        "aoss:*",
        "appconfig:*",
        "appstream:*",
        "autoscaling:*",
        "codebuild:*",
        "codecommit:*",
        "cognito-identity:*",
        "cognito-idp:*",
        "comprehend:*",
        "comprehendmedical:*",
        "dax:*",
        "dynamodb:*",
        "ecr:*",
        "health:*",
        "kinesisvideo:*",
        "kms:*",
        "logs:*",
        "s3:*",
        "secretsmanager:*",
        "sqs:*",
        "sts:*",
        "support:*",
        "textract:*",
        "transcribe:*",
        "translate:*"
      ],
      "Resource": "*",
      "Condition": {
        "Null": {
          "aws:SourceAccount": "false"
        },
        "StringNotEquals": {
          "aws:SourceOrgID": "${aws:ResourceOrgID}"
        }
      }
    }
  ]
}